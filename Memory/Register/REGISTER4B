Inputs: in[4], load;
Outputs: out[4];

Parts:
    dff1 DFF,
    dff2 DFF,
    dff3 DFF,
    dff4 DFF,
    mux1 MUX4B;

Wires:
    dff1.out -> out[1],
    dff1.out -> mux1.in1[1],

    dff2.out -> out[2],
    dff2.out -> mux1.in1[2],

    dff3.out -> out[3],
    dff3.out -> mux1.in1[3],

    dff4.out -> out[4],
    dff4.out -> mux1.in1[4],

    in[1] -> mux1.in2[1],
    in[2] -> mux1.in2[2],
    in[3] -> mux1.in2[3],
    in[4] -> mux1.in2[4],

    load -> mux1.sel,

    mux1.out[1] -> dff1.in,
    mux1.out[2] -> dff2.in,
    mux1.out[3] -> dff3.in,
    mux1.out[4] -> dff4.in;