Inputs: in1, in2, sel;
Outputs: out;

Parts:
    nand1 NAND,
    nand2 NAND,
    nand3 NAND,

    not1 NOT;

Wires:
    sel -> not1.in,

    not1.out -> nand1.in1,
    in1 -> nand1.in2,

    sel -> nand2.in1,
    in2 -> nand2.in2,

    nand1.out -> nand3.in1,
    nand2.out -> nand3.in2,

    nand3.out -> out;